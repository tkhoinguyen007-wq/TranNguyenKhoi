# Discord Bot Token (lấy tại https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Gemini API Key (lấy tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng (mặc định: gemini-3.5-flash-lite để phản hồi nhanh và ổn định nhất)
GEMINI_MODEL=gemini-3.5-flash-lite

# Model dự phòng nếu model chính quá tải (503/timeout)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Mức độ suy nghĩ của AI (minimal để phản hồi nhanh nhất trên flash-lite; low/medium/high nếu cần nghĩ sâu)
GEMINI_THINKING_LEVEL=minimal

# Tính cách / chỉ dẫn mặc định cho bot AI
BOT_SYSTEM_INSTRUCTION=Bạn là một trợ lý AI thân thiện, hữu ích và trả lời ngắn gọn, tự nhiên bằng tiếng Việt (hoặc theo ngôn ngữ người dùng hỏi).

# (Tùy chọn) Guild/Server ID để đồng bộ slash command ngay lập tức khi test
DISCORD_GUILD_ID=

# Port cho HTTP health-check server (Render/Railway tự động gán biến PORT)
PORT=8080

# Phân quyền dạy kiến thức cho bot
MANAGER_ROLE_NAME=Người quản lí
KNOWLEDGE_MANAGER_USERNAMES=_ngkhoi.9999

# (Tùy chọn) Sao lưu kiến thức lên GitHub Gist để không mất khi Render redeploy
KNOWLEDGE_GIST_ID=
KNOWLEDGE_GITHUB_TOKEN=
