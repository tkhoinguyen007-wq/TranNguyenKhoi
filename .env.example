# Discord Bot Token (lấy tại https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Gemini API Key (lấy tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng (mặc định: gemini-4-hydrogen)
GEMINI_MODEL=gemini-4-hydrogen

# Mức độ suy nghĩ của AI (low để phản hồi nhanh nhất trên gemini-4-hydrogen; medium/high nếu cần nghĩ sâu)
GEMINI_THINKING_LEVEL=low

# Tính cách / chỉ dẫn mặc định cho bot AI
BOT_SYSTEM_INSTRUCTION=Bạn là một trợ lý AI thân thiện, hữu ích và trả lời ngắn gọn, tự nhiên bằng tiếng Việt (hoặc theo ngôn ngữ người dùng hỏi).

# (Tùy chọn) Guild/Server ID để đồng bộ slash command ngay lập tức khi test
DISCORD_GUILD_ID=

# Port cho HTTP health-check server (Render/Railway tự động gán biến PORT)
PORT=8080
